+#ifdef STRATA_ENABLE_DLOOP
+bool DFlashDrafter::propose_loop(int32_t x, int64_t pos, const strata::spec::DLoopConfig& config,
+                               int32_t* out, std::string& err, float* probabilities, int& n_drafts) {
+    n_drafts = 0;
+    const std::string invalid = config.error();
+    if (!invalid.empty() || config.block_size > max_rows_ || !out || !probabilities ||
+        pos < 0 || pos + config.drafts() > cap_ || pos + config.drafts() > scratch_cap_ ||
+        (st_[0].kv_elastic >= 0 && pos + config.drafts() > strata::core::qsa_kv_elastic_cells())) {
+        err = invalid.empty() ? "DLoop DFlash block cannot fit the artifact or mapped capacity" : invalid;
+        return false;
+    }
+    const strata::core::OnDevice on_device(device_);
+    const int k = config.block_size;
+    for (int loop = 0; loop < config.max_loops; ++loop) {
+        const int begin = n_drafts;
+        if (!propose(x, pos + begin, k, out + begin, err, probabilities + begin)) return false;
+        n_drafts += k;
+        if (loop + 1 == config.max_loops || !config.extend(probabilities + begin, k)) break;
+        // xn_ is the final norm output returned by DFlashDraftModel.forward,
+        // i.e. Eq. 3's draft-side features. Do not replicate target taps or
+        // pass these through fc: they already have the context's hidden width.
+        if (cudaMemcpyAsync(ctx_, xn_, (size_t) k * artifact_.geom().hidden * sizeof(float),
+                            cudaMemcpyDeviceToDevice, cs_) != cudaSuccess ||
+            !append_context_rows(pos + begin, k, err)) {
+            if (err.empty()) err = "DLoop DFlash feature staging failed";
+            return false;
+        }
+        x = out[n_drafts - 1];
+    }
+    return true;
+}
+#endif
